Project kinopoisk {
  database_type: 'PostgreSQL'
}

Enum age_rating_enum {
  "0+"
  "6+"
  "12+"
  "16+"
  "18+"
}

Enum mpaa_rating_enum {
  "G"
  "PG"
  "PG-13"
  "R"
  "NC-17"
}

Table subscription_type {
  subscription_type_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
  description text [null]
}

Table user_account {
  user_id integer [pk, increment, not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(255) [null]
  registration_date date [not null, default: `CURRENT_DATE`]
  subscription_type_id integer [null]
  subscription_expiry_date date [null]

  indexes {
    subscription_type_id [name: 'idx_user_account_subscription_type_id']
  }
}

Table review {
  review_id integer [pk, increment, not null]
  user_id integer [not null]
  media_id integer [not null]
  rating integer [null, check: `rating BETWEEN 1 AND 10`]
  comment_text text [null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    media_id [name: 'idx_review_media_id']
    user_id [name: 'idx_review_user_id']
  }
}

Table user_list {
  list_id integer [pk, increment, not null]
  user_id integer [not null]
  list_name varchar(255) [not null]

  indexes {
    user_id [name: 'idx_user_list_user_id']
  }
}

Table user_list_media {
  list_id integer [not null]
  media_id integer [not null]

  indexes {
    (list_id, media_id) [pk]
    media_id [name: 'idx_user_list_media_media_id']
  }
}

Table country {
  country_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table media_country {
  media_id integer [not null]
  country_id integer [not null]

  indexes {
    (media_id, country_id) [pk]
    country_id [name: 'idx_media_country']
  }
}

Table genre {
  genre_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table media_genre {
  media_id integer [not null]
  genre_id integer [not null]

  indexes {
    (media_id, genre_id) [pk]
    genre_id [name: 'idx_media_genre']
  }
}

Table media {
  media_id integer [pk, increment, not null]
  imdb_id varchar(50) [null]
  title varchar(255) [not null]
  rating float8 [null]
  votes integer [null]
  en_title varchar(255) [null]
  description text [null]
  short_description text [null]
  slogan text [null]
  release_year integer [null]
  duration integer [null]
  posterurl text [null]
  posterurlpreview text [null]
  logourl text [null]
  age_rating age_rating_enum [null]
  rating_mpaa mpaa_rating_enum [null]
  budget_value json [null]
  fees_world json [null]
  trailer json [null]
  type varchar(50) [null, check: `type IN ('movie', 'series', 'cartoon', 'anime', 'animated-series', 'other')`]

  indexes {
    release_year [name: 'idx_media_release_year']
    type [name: 'idx_media_type']
  }
}

Table person {
  person_id integer [pk, increment, not null]
  ru_name varchar(255) [null]
  en_name varchar(255) [null]
  birth_date date [null]
  photo_url text [null]
}

Table role {
  role_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table media_person_role {
  id integer [pk, increment, not null]
  media_id integer [not null]
  person_id integer [not null]
  role_id integer [not null]
  description text [null]

  indexes {
    (media_id, person_id, role_id) [unique, name: 'uq_media_person_role']
    person_id [name: 'idx_media_person']
    role_id [name: 'idx_media_person_role_role_id']
  }
}

Table connection_type {
  connection_type_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table connected_media {
  media_id integer [not null]
  parent_id integer [not null]
  connection_id integer [not null]

  indexes {
    (media_id, parent_id, connection_id) [pk]
    parent_id [name: 'idx_connected_media_parent']
    connection_id [name: 'idx_connected_media_connection_id']
  }

  checks {
    `media_id <> parent_id` [name: 'chk_connected_media_not_self']
  }
}

Table season {
  season_id integer [pk, increment, not null]
  media_id integer [not null]
  season_number integer [not null]
  release_year integer [null]

  indexes {
    (media_id, season_number) [unique, name: 'season_media_id_season_number_key']
    media_id [name: 'idx_season_media_id']
  }
}

Table episode {
  episode_id integer [pk, increment, not null]
  season_id integer [not null]
  episode_number integer [not null]
  title varchar(255) [null]
  release_date date [null]
  description text [null]

  indexes {
    (season_id, episode_number) [unique, name: 'episode_season_id_episode_number_key']
    season_id [name: 'idx_episode_season_id']
  }
}

Ref user_account_subscription_type_id_fkey: user_account.subscription_type_id > subscription_type.subscription_type_id [delete: no action, update: no action]
Ref review_user_id_fkey: review.user_id > user_account.user_id [delete: cascade, update: no action]
Ref fk_review_media_id: review.media_id > media.media_id [delete: cascade, update: no action]
Ref user_list_user_id_fkey: user_list.user_id > user_account.user_id [delete: cascade, update: no action]
Ref user_list_media_list_id_fkey: user_list_media.list_id > user_list.list_id [delete: cascade, update: no action]
Ref fk_user_list_media_media_id: user_list_media.media_id > media.media_id [delete: cascade, update: no action]
Ref media_country_country_id_fkey: media_country.country_id > country.country_id [delete: cascade, update: no action]
Ref media_country_media_id_fkey: media_country.media_id > media.media_id [delete: cascade, update: no action]
Ref media_genre_genre_id_fkey: media_genre.genre_id > genre.genre_id [delete: cascade, update: no action]
Ref media_genre_media_id_fkey: media_genre.media_id > media.media_id [delete: cascade, update: no action]
Ref media_person_role_media_id_fkey: media_person_role.media_id > media.media_id [delete: cascade, update: no action]
Ref media_person_role_person_id_fkey: media_person_role.person_id > person.person_id [delete: cascade, update: no action]
Ref media_person_role_role_id_fkey: media_person_role.role_id > role.role_id [delete: cascade, update: no action]
Ref connected_media_connection_id_fkey: connected_media.connection_id > connection_type.connection_type_id [delete: cascade, update: no action]
Ref fk_connected_media_media_id: connected_media.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_connected_media_parent_id: connected_media.parent_id > media.media_id [delete: cascade, update: no action]
Ref season_media_id_fkey: season.media_id > media.media_id [delete: cascade, update: no action]
Ref episode_season_id_fkey: episode.season_id > season.season_id [delete: cascade, update: no action]
