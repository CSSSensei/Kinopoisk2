Project kinopoisk {
  database_type: 'PostgreSQL'
}

Enum age_rating_enum {
  "0+"
  "6+"
  "12+"
  "16+"
  "18+"
}

Enum mpaa_rating_enum {
  G
  PG
  "PG-13"
  R
  "NC-17"
}

Table subscription_type {
  subscription_type_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table app_user {
  user_id integer [pk, increment, not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  last_name varchar(255) [null]
  first_name varchar(255) [null]
  middle_name varchar(255) [null]
  registration_date timestamptz [not null, default: `now()`]
  subscription_type_id integer [null]
  subscription_expiry_date date [null]

  indexes {
    subscription_type_id [name: 'idx_app_user_subscription_type_id']
  }
}

Table review {
  review_id integer [pk, increment, not null]
  user_id integer [not null]
  media_id integer [not null]
  rating smallint [null, check: `rating BETWEEN 1 AND 10`]
  comment_text text [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_review_user_id']
    media_id [name: 'idx_review_media_id']
  }
}

Table user_list {
  list_id integer [pk, increment, not null]
  user_id integer [not null]
  list_name varchar(255) [not null]

  indexes {
    user_id [name: 'idx_user_list_user_id']
  }
}

Table user_list_media {
  list_id integer [not null]
  media_id integer [not null]

  indexes {
    (list_id, media_id) [pk]
    media_id [name: 'idx_user_list_media_media_id']
  }
}

Table country {
  country_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table media_country {
  media_id integer [not null]
  country_id integer [not null]

  indexes {
    (media_id, country_id) [pk]
    country_id [name: 'idx_media_country_country_id']
  }
}

Table genre {
  genre_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table media_genre {
  media_id integer [not null]
  genre_id integer [not null]

  indexes {
    (media_id, genre_id) [pk]
    genre_id [name: 'idx_media_genre_genre_id']
  }
}

Table media {
  media_id integer [pk, increment, not null]
  ru_title varchar(255) [null]
  en_title varchar(255) [null]
  original_title varchar(255) [null]
  description text [null]
  short_description text [null]
  slogan text [null]
  release_year integer [null]
  duration_minutes integer [null]
  poster_url text [null]
  poster_preview_url text [null]
  cover_url text [null]
  logo_url text [null]
  age_rating age_rating_enum [null]
  rating_mpaa mpaa_rating_enum [null]
  budget_value numeric(18,2) [null]
  worldwide_gross numeric(18,2) [null]
  media_type varchar(50) [null, check: `media_type IN ('movie', 'series', 'cartoon', 'anime', 'animated-series', 'other')`]

  indexes {
    media_type [name: 'idx_media_type']
    release_year [name: 'idx_media_release_year']
  }
}

Table person {
  person_id integer [pk, increment, not null]
  last_name varchar(255) [null]
  first_name varchar(255) [null]
  middle_name varchar(255) [null]
  birth_date date [null]
  bio text [null]
}

Table role {
  role_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table media_person_role {
  id integer [pk, increment, not null]
  media_id integer [not null]
  person_id integer [not null]
  role_id integer [not null]

  indexes {
    (media_id, person_id, role_id) [unique, name: 'uq_media_person_role']
    person_id [name: 'idx_media_person_role_person_id']
    role_id [name: 'idx_media_person_role_role_id']
  }
}

Table connection_type {
  connection_type_id integer [pk, increment, not null]
  name varchar(100) [not null, unique]
}

Table connected_media {
  media_id integer [not null]
  parent_media_id integer [not null]
  connection_type_id integer [not null]

  indexes {
    (media_id, parent_media_id, connection_type_id) [pk]
    parent_media_id [name: 'idx_connected_media_parent_media_id']
    connection_type_id [name: 'idx_connected_media_connection_type_id']
  }

  checks {
    `media_id <> parent_media_id` [name: 'chk_connected_media_not_self']
  }
}

Table season {
  season_id integer [pk, increment, not null]
  media_id integer [not null]
  season_number integer [not null]
  title varchar(255) [null]

  indexes {
    (media_id, season_number) [unique, name: 'uq_season_media_number']
  }
}

Table episode {
  episode_id integer [pk, increment, not null]
  season_id integer [not null]
  episode_number integer [not null]
  title varchar(255) [null]
  duration_minutes integer [null]
  description text [null]

  indexes {
    (season_id, episode_number) [unique, name: 'uq_episode_season_number']
  }
}

Ref fk_app_user_subscription_type_id: app_user.subscription_type_id > subscription_type.subscription_type_id [delete: no action, update: no action]
Ref fk_review_user_id: review.user_id > app_user.user_id [delete: cascade, update: no action]
Ref fk_review_media_id: review.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_user_list_user_id: user_list.user_id > app_user.user_id [delete: cascade, update: no action]
Ref fk_user_list_media_list_id: user_list_media.list_id > user_list.list_id [delete: cascade, update: no action]
Ref fk_user_list_media_media_id: user_list_media.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_media_country_media_id: media_country.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_media_country_country_id: media_country.country_id > country.country_id [delete: cascade, update: no action]
Ref fk_media_genre_media_id: media_genre.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_media_genre_genre_id: media_genre.genre_id > genre.genre_id [delete: cascade, update: no action]
Ref fk_media_person_role_media_id: media_person_role.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_media_person_role_person_id: media_person_role.person_id > person.person_id [delete: cascade, update: no action]
Ref fk_media_person_role_role_id: media_person_role.role_id > role.role_id [delete: cascade, update: no action]
Ref fk_connected_media_media_id: connected_media.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_connected_media_parent_media_id: connected_media.parent_media_id > media.media_id [delete: cascade, update: no action]
Ref fk_connected_media_connection_type_id: connected_media.connection_type_id > connection_type.connection_type_id [delete: cascade, update: no action]
Ref fk_season_media_id: season.media_id > media.media_id [delete: cascade, update: no action]
Ref fk_episode_season_id: episode.season_id > season.season_id [delete: cascade, update: no action]
